<mxfile host="Electron" type="device"><diagram id="C4 - Contexto" name="C4 - Contexto"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;&lt;font style='font-size:18px'&gt;Diagrama de contexto (C4, nível 1)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Software Web para Autenticação de Usuários&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Usuário&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Informa login ou e-mail e senha." style="html=1;whiteSpace=wrap;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingTop=60;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="220" height="200" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Software Web de Autenticação&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#E6E6E6'&gt;[Sistema de software]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Verifica as credenciais e devolve a identificação do usuário ou um erro de autenticação.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="370" y="390" width="280" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Cadastro de usuários&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;f