<mxfile host="Electron" type="device"><diagram id="C4 - Conteineres" name="C4 - Conteineres"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;&lt;font style='font-size:18px'&gt;Diagrama de contêineres (C4, nível 2)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Software Web de Autenticação&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Usuário&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Pessoa]&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingTop=60;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="220" height="200" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Software Web de Autenticação&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Sistema de software]&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=6;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1020" height="520" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Aplicação Web&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#E6E6E6'&gt;[Contêiner: HTML + TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Página de login. Envia as credenciais com fetch e mostra o resultado.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#438DD5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="280" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;API de Autenticação&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#E6E6E6'&gt;[Contêiner: Node.js + TypeScript (node:http)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Entrega a página de login, atende POST /api/login e responde 200 ou 401.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#438DD5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="400" width="280" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Banco de Dados&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#E6E6E6'&gt;[Contêiner: SQLite (arquivo local)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Tabela usuario com login, e-mail, nome e hash da senha.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="280" height="150" as="geometry"/></mxCell><mxCell id="c9" value="Digita login e senha" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="POST /api/login&lt;br&gt;[HTTPS, JSON]" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fo