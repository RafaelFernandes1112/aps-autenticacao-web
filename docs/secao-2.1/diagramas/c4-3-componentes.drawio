<mxfile host="Electron" type="device"><diagram id="C4 - Componentes" name="C4 - Componentes"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;&lt;font style='font-size:18px'&gt;Diagrama de componentes da API de Autenticação (C4, nível 3)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Contêiner API de Autenticação&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1180" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Usuário&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Pessoa]&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#073B6F;fontColor=default;align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="80" width="140" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;API de Autenticação&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Contêiner: Java + Spring Boot]&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingBottom=6;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1180" height="470" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;AuthController&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente: @RestController]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Atende POST /api/login, valida os campos e devolve 200, 400 ou 401.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="320" width="280" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;AuthService&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente: @Service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Busca o usuário e confere a senha. Usuário inexistente e senha errada dão o mesmo erro.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="570" width="280" height="140" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;UserRepository&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente: JdbcTemplate]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Busca o usuário por login ou e-mail no SQLite.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="280" height="140" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;PasswordEncoder&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente: BCryptPasswordEncoder]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Confere a senha com o hash usando BCrypt.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="570" width="280" height="140" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Banco de Dados&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#E6E6E6'&gt;[Contêiner: SQLite]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Tabela usuario.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="830" width="280" height="130" as="geometry"/></mxCell><mxCell id="c11" value="POST /api/login&lt;br&gt;{identificador, senha}&lt;br&gt;[HTTPS, JSON]" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="200 {id, nome}&lt;br&gt;ou 400 / 401 {erro}" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashPattern=2 3;strokeColor=#2E7D32;fontColor=#2E7D32;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="autenticar(&lt;br&gt;identificador, senha)" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="UserIdentity {id, nome}&lt;br&gt;ou AuthenticationException" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashPattern=2 3;strokeColor=#2E7D32;fontColor=#2E7D32;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="buscar usuário&lt;br&gt;→ Usuario ou vazio" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="verificar senha&lt;br&gt;→ true ou false" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="SELECT com parâmetros&lt;br&gt;[SQL]" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="320" width="160" height="20" as="geometry"/></mxCell><mxCell id="c19" value="Pessoa" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="346" width="160" height="30" as="geometry"/></mxCell><mxCell id="c20" value="Contêiner" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#438DD5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="384" width="160" height="30" as="geometry"/></mxCell><mxCell id="c21" value="Componente" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="422" width="160" height="30" as="geometry"/></mxCell><mxCell id="c22" value="Banco de dados" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="160" height="40" as="geometry"/></mxCell><mxCell id="c23" value="&lt;font style='font-size:10px'&gt;Setas tracejadas: dependência ou fluxo de dados,&lt;br&gt;no sentido de quem inicia a chamada.&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="508" width="260" height="30" as="geometry"/></mxCell><mxCell id="c24" value="&lt;font style='font-size:10px' color='#2E7D32'&gt;Setas verdes pontilhadas: resposta.&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="540" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
