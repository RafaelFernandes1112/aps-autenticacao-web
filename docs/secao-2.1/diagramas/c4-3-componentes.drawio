<mxfile host="Electron" type="device"><diagram id="C4 - Componentes" name="C4 - Componentes"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;&lt;font style='font-size:18px'&gt;Diagrama de componentes da API de Autenticação (C4, nível 3)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Contêiner API de Autenticação&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1180" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Aplicação Web&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#E6E6E6'&gt;[Contêiner: HTML + TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Envia as credenciais com fetch.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#438DD5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="90" width="280" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;API de Autenticação&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Contêiner: Node.js + TypeScript]&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingBottom=6;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1180" height="640" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;server.ts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente: node:http]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Sobe o servidor, entrega a página de login e envia POST /api/login ao AuthController.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="300" width="280" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;AuthController&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Lê o JSON, valida os campos e devolve 200, 400 ou 401.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="500" width="280" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;AuthService&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Busca o usuário e confere a senha. Usuário inexistente e senha errada dão o mesmo erro.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="700" width="280" height="140" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;UserRepository&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Busca o usuário por login ou e-mail no SQLite.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="280" height="140" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;PasswordHasher&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#1E3A5F'&gt;[Componente: node:crypto]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Confere a senha com o hash usando scrypt.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="280" height="140" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Banco de Dados&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#E6E6E6'&gt;[Contêiner: SQLite]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Tabela usuario.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="960" width="280" height="130" as="geometry"/></mxCell><mxCell id="c12" value="POST /api/login&lt;br&gt;[HTTPS, JSON]" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Encaminha" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="autenticar()" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="buscar usuário" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="verificar senha" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="SELECT com parâmetros&lt;br&gt;[SQL]" style="endArrow=blockThin;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="160" height="20" as="geometry"/></mxCell><mxCell id="c19" value="Contêiner" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#438DD5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="326" width="160" height="30" as="geometry"/></mxCell><mxCell id="c20" value="Componente" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#6FA8DC;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="364" width="160" height="30" as="geometry"/></mxCell><mxCell id="c21" value="Banco de dados" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="402" width="160" height="40" as="geometry"/></mxCell><mxCell id="c22" value="&lt;font style='font-size:10px'&gt;Setas tracejadas: dependência ou fluxo de dados,&lt;br&gt;no sentido de quem inicia a chamada.&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="260" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
