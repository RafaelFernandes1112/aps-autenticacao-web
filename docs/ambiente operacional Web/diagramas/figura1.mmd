flowchart TB
  subgraph rede["Infraestrutura de rede"]
    dns["Servidor DNS<br>(item 1.3)"]
  end

  subgraph cliente["Lado do cliente"]
    direction LR
    usuario["Usuário"] --> nav["Navegador<br>(item 1.2)"]
  end

  subgraph servidor["Lado do servidor"]
