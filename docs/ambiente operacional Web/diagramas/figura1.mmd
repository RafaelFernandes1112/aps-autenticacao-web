    subgraph proc["Processo Java da aplicação Spring Boot (Java 21)"]
      direction LR
      tomcat["Servidor web<br>Tomcat embutido<br>(item 1.5)"]
      app["Servidor de aplicação<br>Spring Boot + Spring MVC<br>(item 1.6)"]
      sqlite["SQLite<br>biblioteca embutida<br>(item 1.7)"]
      tomcat <-- "3) chamada ao DispatcherServlet,<br>no mesmo processo" --> app
      app <-- "4) SQL via JDBC,<br>no mesmo processo" --> sqlite
    end
    db[("Arquivo do banco<br>auth.db")]
