<mxCell id="N" value="&lt;b&gt;Restrições e índices&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK: id (índice automático).&lt;br&gt;UK: login e email são únicos; cada um tem índice usado na consulta de autenticação.&lt;br&gt;CHECK: login e email gravados em minúsculas; login sem &#39;@&#39;; email com &#39;@&#39;.&lt;br&gt;A senha nunca é gravada em texto (RNF02)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="410" height="184" as="geometry"/></mxCell>
